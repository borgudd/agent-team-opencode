#!/usr/bin/env bash
# Product Owner (Opus 5). This is the one you talk to.
# Prefer the self-updated claude (~/.local/bin) over an older npm/brew copy,
# which may reject newer model IDs. Falls back to the PATH `claude` otherwise.
[ $# -gt 0 ] || set -- 'Begin. Follow the "On start" section of your role.'
exec "$(dirname "$0")/_start" po product-owner.md \
  env PATH="$HOME/.local/bin:$PATH" \
  claude --model opus --append-system-prompt-file ROLEFILE "$@"
