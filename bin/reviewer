#!/usr/bin/env bash
# Reviewer (Sonnet 5). Reviews open PRs.
# A different model from the Coder, but the same family — the independence
# this role used to get from a separate provider now has to come from its
# process: read the diff, not the PR description. See team/roles/reviewer.md.
[ $# -gt 0 ] || set -- 'Begin. Follow the "On start" section of your role.'
exec "$(dirname "$0")/_start" reviewer reviewer.md \
  env PATH="$HOME/.local/bin:$PATH" \
  claude --model sonnet --append-system-prompt-file ROLEFILE "$@"
