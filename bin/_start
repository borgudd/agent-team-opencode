#!/usr/bin/env bash
# shared preamble for the role launchers: sync, resolve role file, sanity-check the clone, run
# usage: _start <role> <role-file-basename> <cmd...>   ("ROLEFILE" in cmd is replaced)
#
# Fallbacks: FALLBACK_1, FALLBACK_2, ... each a FULL single command string, tried in order
# when the preceding command exits with a credit/rate-limit error (detected in stderr).
# Note: claude roles often keep running while limited (inline spend-limit bubble) instead of
# exiting — the watchdog handles that case by watching the pane text and respawning the role
# on its fallback launcher; _start is the exit-code path for when the process does die.
set -uo pipefail
role="$1"; rolefile="$2"; shift 2
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT"
SKILL="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

here="$(basename "$PWD")"
case "$here" in
  "$role"|"$role"-[0-9]*) ;;
  *) echo "warning: starting the $role in clone '$here' — each role should have its own clone" >&2 ;;
esac

git pull -q --rebase --autostash 2>/dev/null || echo "warning: git pull failed — check the remote before working" >&2
git submodule update -q --init --recursive 2>/dev/null || true

# project override wins over the submodule's role file
if [ -f ".team/roles/$rolefile" ]; then
  RF=".team/roles/$rolefile"
else
  RF="$SKILL/team/roles/$rolefile"
fi

primary=()
for a in "$@"; do primary+=("${a//ROLEFILE/$RF}"); done

# Collect fallbacks from FALLBACK_1, FALLBACK_2, ... (each is one full command string)
fallbacks=()
i=1
while true; do
  var="FALLBACK_$i"
  val="${!var:-}"
  [ -z "$val" ] && break
  fallbacks+=("$val")
  i=$((i + 1))
done

is_retryable() {
  grep -qiE "spend limit|credit limit|rate limit|monthly.*limit|limit resets|usage limit|quota|insufficient|billing|payment required|exceeded|429|503" <<<"$1"
}

# Run one candidate: exit 0 on success, exit <rc> on hard error, return 3 when retryable.
exec_one() {
  local tmp tail_pid err rc
  tmp="$(mktemp)"
  tail -F "$tmp" >&2 &
  tail_pid=$!
  if [ "$1" = _primary ]; then
    "${primary[@]}" 2>"$tmp"
  else
    bash -c "$1" 2>"$tmp"
  fi
  rc=$?
  kill "$tail_pid" 2>/dev/null; wait "$tail_pid" 2>/dev/null || true
  if [ $rc -eq 0 ]; then rm -f "$tmp"; exit 0; fi
  err="$(cat "$tmp")"; rm -f "$tmp"
  if is_retryable "$err"; then
    echo "[$role] retryable error detected — ${err%%$'\n'*}" >&2
    return 3
  fi
  echo "[$role] exited with code $rc" >&2
  [ -n "$err" ] && echo "$err" >&2
  exit $rc
}

echo "[$role] starting (primary)" >&2
exec_one _primary || true
for fb in "${fallbacks[@]}"; do
  echo "[$role] fallback: ${fb%% *} ..." >&2
  sleep 2
  exec_one "$fb" || true
done