#!/usr/bin/env bash
# Product Owner fallback — claude --model sonnet (the primary po is opus); used by
# the watchdog when a spend limit blocks the primary. Note the whole team now
# draws on one Claude account, so a limit is often account-wide rather than
# per-model — this buys headroom where opus is capped tighter, not immunity.
[ $# -gt 0 ] || set -- 'Begin. Follow the "On start" section of your role.'
exec "$(dirname "$0")/_start" po product-owner.md \
  env PATH="$HOME/.local/bin:$PATH" \
  claude --model sonnet --append-system-prompt-file ROLEFILE "$@"
