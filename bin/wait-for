#!/usr/bin/env bash
# Block until the board has something for <role>.
#   exit 0  and print the rows     — there is work
#   exit 1  after MAX seconds      — nothing yet; the caller just runs it again
#   exit 2  board unreliable       — git fetch or gh failed; tell the human, do not loop
# usage: wait-for <po|architect|coder|reviewer> [MAX seconds, default 540] [POLL seconds, default 30]
#
# Rows for a role are offered pre-sorted: precedence class first (a role's own
# statuses, most-urgent-to-act-on first — e.g. the Coder clears `needs-fix`
# before `ci-fails`/`changes-requested` before `planned`), then urgency
# (`urge: true` on a story, story 027), then story ID. Urgency orders *within*
# a class; it never lets a later class jump an earlier one, and a status not
# listed for a role never reaches it — `bin/status` already withheld it via
# `next`.
set -uo pipefail
role="${1:?role}"; max="${2:-540}"; every="${3:-30}"
cd "$(git rev-parse --show-toplevel)" || exit 1
BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Lower rank = offered first. Anything not listed for a role ranks last (9)
# rather than erroring — it should never actually reach that role (`next`
# already filters it out), and a bare `sort -k…` over a clever lookup keeps
# this readable at bash 3.2.
class_rank() {
  case "$1:$2" in
    architect:needs-replan) echo 0 ;;
    architect:ready) echo 1 ;;
    coder:needs-fix) echo 0 ;;
    coder:ci-fails) echo 1 ;;
    coder:changes-requested) echo 1 ;;
    coder:planned) echo 2 ;;
    coder:in-progress) echo 3 ;;
    reviewer:in-review) echo 1 ;;
    # A broken dependency declaration (dep-missing/dep-cycle) silently holds
    # up every story that names it, not just its own — it outranks a
    # needs-split, which only holds up itself.
    po:dep-missing) echo 0 ;;
    po:dep-cycle) echo 0 ;;
    po:needs-split) echo 1 ;;
    *) echo 9 ;;
  esac
}

t=0
while :; do
  err="$(mktemp)"
  tsv="$("$BIN/status" --tsv 2>"$err")"
  warn="$(grep '^warning' "$err" || true)"; rm -f "$err"
  if [ -n "$warn" ]; then
    echo "cannot trust the board from here:"; echo "$warn"
    echo "fix the environment (network / gh auth login) and start again — do not keep looping"; exit 2
  fi

  keyed=""
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    # `IFS=$'\t' read` looks right but is wrong: bash treats tab as
    # IFS-whitespace regardless of what IFS is set to, so it collapses
    # consecutive tabs and strips them at the edges -- exactly what a story
    # with an empty `where` column (bin/status never sets one for `ready` or
    # `needs-split`) produces. That silently shifted `urge` into `where` and
    # left `urge` empty, so every `ready`/`needs-split` row read as
    # non-urgent no matter what the story said (caught in review). \x02 is
    # not IFS-whitespace, so splitting on it does not collapse empty fields --
    # unlike \x01, which this bash 3.2 (the floor for this repo) silently
    # fails to split on at all; verified before picking it.
    IFS=$'\x02' read -r id status title next where urge <<< "${line//$'\t'/$'\x02'}"
    [ "$next" = "$role" ] || continue
    rank="$(class_rank "$role" "$status")"
    urgekey=1; [ "$urge" = "1" ] && urgekey=0
    keyed="$keyed$rank"$'\t'"$urgekey"$'\t'"$id"$'\t'"$status"$'\t'"$title"$'\n'
  done <<< "$tsv"

  rows="$(printf '%s' "$keyed" | sort -t $'\t' -k1,1n -k2,2n -k3,3n | awk -F'\t' 'NF{printf "%s  %-18s %s\n", $3, $4, $5}')"

  if [ -n "$rows" ]; then
    git pull -q --rebase --autostash 2>/dev/null || true
    echo "work for $role:"; echo "$rows"; exit 0
  fi
  if [ "$t" -ge "$max" ]; then echo "nothing for $role after ${max}s — run wait-for again"; exit 1; fi
  sleep "$every"; t=$((t + every))
done
