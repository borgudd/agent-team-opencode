#!/usr/bin/env bash
# Reviewer fallback — opencode gpt-5.6-terra-fast (the primary reviewer is gpt-5.6-terra);
# used by the watchdog when the OpenAI account is rate-limited on the full model.
[ $# -gt 0 ] || set -- 'Begin. Follow the "On start" section of your role.'
exec "$(dirname "$0")/_start" reviewer reviewer.md \
  env OPENCODE_CONFIG="$HOME/.config/opencode/agent-team-terra-fast.json" \
  opencode run --interactive \
  'You are the Reviewer. Read AGENTS.md, then your role file at ROLEFILE, and follow its "On start" section.' "$@"