#!/usr/bin/env bash
# The board. Status is derived from git and GitHub — never written by hand.
#
#   ready              story on main, no plan                     → architect
#   needs-split        plan says the story is too big             → po
#   planned            plan on main, no branch yet                → coder
#   needs-replan       coder note newer than the plan             → architect
#   in-progress        remote branch exists, no PR                → coder
#   unknown            branch exists but GitHub could not be asked → nobody (look, don't work)
#   in-review          PR open, no review yet or new commits since → reviewer
#   changes-requested  review file on the branch says so           → coder
#   approved           review file on the branch says so           → human (merge)
#   ci-fails          PR branch's latest run failed, errored, timed out,
#                     was cancelled, or never ran                     → reviewer
#   needs-fix         main CI is red and this story merged it         → coder
#   approved          review file on the branch says so               → po (merge)
# Rows in an actionable state whose last activity is older than STALE_HOURS
# (default 24) get a "(stale Nh)" marker on the title — the board's escape
# valve, so no story can quietly stall in a lane.
# The verdict is the `verdict:` line of .team/reviews/NNN-*.md on the PR branch — git, not
# GitHub's review decision (which GitHub refuses when one account authored the PR and reviews it).
#   done / closed      PR merged / closed                         → —
#   blocked            a declared dependency is not `done` yet    → nobody (wait)
#   dep-missing        `depends-on:` names a story that does not exist → po
#   dep-cycle          declared dependencies form a loop (incl. self) → po
#
# A story — or a plan, discovered while planning — may declare `depends-on: 001, 002`
# in its frontmatter: one line, comma-separated, plain IDs; nothing here parses YAML.
# Only `done` satisfies a dependency. Unknown, closed, blocked and error rows all count
# as not done, so a dependency GitHub cannot be asked about (AC8) blocks rather than
# slips through as workable — the same lesson this script wrote down below for PRs.
set -uo pipefail
TSV=0; [ "${1:-}" = "--tsv" ] && TSV=1   # machine-readable: id<TAB>status<TAB>title<TAB>next<TAB>where<TAB>urge, no header
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! git fetch -q origin 2>/dev/null; then
  echo "warning: git fetch failed — no network from here? the board may be stale" >&2
fi

DEFAULT="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
[ -n "$DEFAULT" ] || DEFAULT=main
MAIN="origin/$DEFAULT"

# How old a row may be in an actionable state before it gets a `(stale Nh)`
# marker. Age comes from the PR's last update (when the story has a PR) or the
# story/branch commit time otherwise; informational — it exists so wait-for
# hands an opener a stale story and the Reviewer's idle sweep can name it.
STALE_HOURS="${STALE_HOURS:-24}"
now="$(date +%s)"

# Every PR in the repo, in one query. It used to be one `gh pr list` per story,
# which is a GraphQL call per story per run: a thirty-story backlog polled by
# four roles every ninety seconds spends an API budget in an afternoon, and what
# happens when it runs out is worse than slowness — see below.
have_gh=0
gh_why=""
prs=""
if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
  gh_why="no gh"
  echo "warning: gh missing, not authenticated, or no network — PR states unknown; branches show as unknown" >&2
elif prs="$(gh pr list --state all --limit 500 --json number,state,headRefName,updatedAt \
            --jq '.[] | [.headRefName, .number, .state, ((now - (.updatedAt|fromdateiso8601)) / 3600 | floor)] | @tsv' 2>/dev/null)"; then
  have_gh=1
else
  # The distinction that matters. A failed query and a repo with no PRs both
  # come back empty, and reading a failure as "no PR yet" hands every merged
  # story back to the Coder as fresh work. Rate-limit exhaustion did exactly
  # that: thirty-one `done` stories turned into thirty-one `in-progress` rows
  # in the Coder's lane, with no warning, because the error was swallowed.
  gh_why="gh failed"
  echo "warning: gh could not list PRs (rate limit? network?) — PR states unknown; branches show as unknown" >&2
fi

# CI visibility for the board. Two extra gh list calls, once per poll: the set of
# branches whose latest PR-event run went badly — failed, errored, timed out, or
# cancelled (red or stalled PR -> ci-fails), plus branches with an open PR that
# has no PR-event run at all (stalled -> ci-fails) — and the latest main run
# (red main, attributed to a story by the 3-digit id in its commit message ->
# needs-fix). Both are advisory facts about GitHub; when gh cannot be asked they
# simply leave the existing lanes alone, matching the prs block above.
redprs=""; redmain=""; stale_prs=""
if [ "$have_gh" -eq 1 ]; then
  raw_runs="$(gh run list --limit 500 --json headBranch,event,conclusion,createdAt \
            --jq '.[] | select(.event=="pull_request") | [.headBranch,.conclusion,.createdAt] | @tsv' \
            2>/dev/null)"
  # Newest run per branch first (createdAt sorts lexicographically; gh list is
  # already newest-first, this is belt and braces), then the ones that went bad.
  redprs="$(printf '%s\n' "$raw_runs" | sort -k3r | awk -F'\t' '!s[$1]++ { if ($2=="failure"||$2=="errored"||$2=="timed_out"||$2=="cancelled") print $1 }' | sort -u | tr '\n' ' ')"
  runs_branches="$(printf '%s\n' "$raw_runs" | cut -f1 | sort -u | tr '\n' ' ')"
  if [ -n "$prs" ] && [ -n "$runs_branches" ]; then
    # An open PR branch the runs list has never seen is stalled — the reviewer
    # sweep requeues or re-triggers it. Brand-new branches appear in the runs
    # list the moment a workflow starts (queued), so this does not false-fire.
    stale_prs="$(printf '%s\n' "$prs" | awk -F'\t' '$3=="OPEN" && $1!="" {print $1}' \
      | while read -r b; do case " $runs_branches " in *" $b "*) ;; *) printf '%s\n' "$b" ;; esac; done | sort -u | tr '\n' ' ')"
  fi"
  latest_main="$(gh run list --branch "${MAIN#origin/}" --limit 1 --json conclusion,displayTitle \
            --jq '.[0].conclusion, .[0].displayTitle' 2>/dev/null)"
  mc="$(printf "%s" "$latest_main" | sed -n 1p)"
  mt="$(printf "%s" "$latest_main" | sed -n 2p)"
  if [ "$mc" = "failure" ] && [ -n "$mt" ]; then
    redmain="$(printf "%s" "$mt" | grep -oE "[0-9]{3}" | head -1)"
  fi
fi

stories="$(git ls-tree -r --name-only "$MAIN" -- .team/backlog/ 2>/dev/null | grep -E '/[0-9]{3}-.*\.md$' | sort)"
if [ -z "$stories" ]; then [ "$TSV" -eq 1 ] || echo "backlog is empty"; exit 0; fi

first_line() { git show "$MAIN:$1" 2>/dev/null | sed -n "s/^$2: *//p" | head -1; }
ctime()      { git log -1 --format=%ct "$MAIN" -- "$1" 2>/dev/null || echo 0; }
idxof()      { local i; for i in "${!ids[@]}"; do [ "${ids[$i]}" = "$1" ] && { echo "$i"; return; }; done; }
in_cycle()   { # $1 = start index; true if a declared cycle passes through it (incl. self)
  # Forward reachability from start: node is in a cycle iff a successor eventually
  # points back at start. A plain indexed-array BFS — safe on bash 3.2.
  local start=$1 i j ji head=0
  local seen=()
  local q=("$start")
  seen[$start]=1
  while [ "$head" -lt "${#q[@]}" ]; do
    i="${q[$head]}"; head=$((head + 1))
    for j in ${deps[$i]}; do
      ji="$(idxof "$j")"; [ -n "$ji" ] || continue
      if [ "$ji" -eq "$start" ]; then return 0; fi
      [ "${seen[$ji]:-0}" -eq 1 ] && continue
      seen[$ji]=1; q+=("$ji")
    done
  done
  return 1
}

[ "$TSV" -eq 1 ] || printf '%-4s %-5s %-18s %-38s %-10s %s\n' ID URGE STATUS TITLE NEXT WHERE

# ---- pass one: the intrinsic status of every story, exactly as before. Dependency
# gating cannot happen inline: a row's verdict depends on the *other* rows, so every
# intrinsic status must be known before any final row is decided. Collect it all first.
ids=(); titles=(); sts=(); nxs=(); whs=(); deps=(); miss=(); urgs=(); aghs=(); paths=()
while IFS= read -r story; do
  base="$(basename "$story" .md)"; id="${base%%-*}"
  title="$(first_line "$story" title)"
  # `urge:` is a PO input read from the story only — not the plan, which is the
  # Architect's reach. Anything but true/yes/1 (a bare marker, a typo, a word)
  # is not urgent; the row is still emitted either way (AC7, AC8).
  case "$(first_line "$story" urge | tr '[:upper:]' '[:lower:]')" in
    true|yes|1) urgent=1 ;;
    *) urgent=0 ;;
  esac
  plan="$(git ls-tree -r --name-only "$MAIN" -- .team/plans/ | grep "/${id}-" | head -1)"
  note="$(git ls-tree -r --name-only "$MAIN" -- .team/notes/ | grep "/${id}-" | head -1)"
  branch="$(git branch -r --list "origin/feat/${id}-*" | head -1 | sed 's|^ *origin/||')"
  status=""; next=""; where=""; age_v=""

  if [ -z "$plan" ]; then
    status=ready; next=architect
  elif [ "$(first_line "$plan" verdict)" = "needs-split" ]; then
    status=needs-split; next=po
  elif [ -n "$note" ] && [ "$(ctime "$note")" -gt "$(ctime "$plan")" ]; then
    status=needs-replan; next=architect; where="$note"
  elif [ -z "$branch" ]; then
    # No remote branch is "no work yet" only until proven otherwise: a merged
    # (or closed) PR gets its branch deleted too — by the merge flow or by
    # hand — and without this fallback a finished story re-enters the board as
    # `planned` forever the moment its branch is gone, so the Coder redoes it.
    fallback_pr=""
    if [ "$have_gh" -eq 1 ]; then
      fallback_pr="$(printf '%s\n' "$prs" | awk -F'\t' -v id="$id" '$1 ~ "^feat/" id "-" {print $1"\t"$2"\t"$3"\t"$4; exit}')"
    fi
    if [ -z "$fallback_pr" ]; then
      status=planned; next=coder; where="$plan"
    else
      IFS=$'\t' read -r _fb_branch fb_num fb_state fb_age <<< "$fallback_pr"
      age_v="${fb_age:-}"
      where="#$fb_num"
      case "$fb_state" in
        MERGED) status=done; next="—" ;;
        CLOSED) status=closed; next="—" ;;
        # Branch gone but the PR is still open is rare (manual branch delete);
        # there is no branch left to read a review verdict from, so hand it
        # back to the reviewer rather than guessing.
        *) status=in-review; next=reviewer; where="$where (branch deleted)" ;;
      esac
    fi
  elif [ "$have_gh" -eq 0 ]; then
    # Not `in-progress`: we do not know, and `next` must not name a role, or an
    # unattended Coder picks the row up. `wait-for` matches the role exactly.
    status=unknown; next="—"; where="$branch ($gh_why)"
    bct="$(git log -1 --format=%ct "origin/$branch" 2>/dev/null || echo 0)"; [ "$bct" -gt 0 ] 2>/dev/null && age_v=$(( (now - bct) / 3600 ))
  else
    pr="$(printf '%s\n' "$prs" | awk -F'\t' -v b="$branch" '$1==b {print $2"\t"$3"\t"$4; exit}')"
    if [ -z "$pr" ]; then
      status=in-progress; next=coder; where="$branch"
      bct="$(git log -1 --format=%ct "origin/$branch" 2>/dev/null || echo 0)"; [ "$bct" -gt 0 ] 2>/dev/null && age_v=$(( (now - bct) / 3600 ))
    else
      IFS=$'\t' read -r num state prh <<< "$pr"
      age_v="$prh"
      where="#$num"
      case "$state" in
        MERGED) status=done; next="—" ;;
        CLOSED) status=closed; next="—" ;;
        *)
          # The verdict lives in .team/reviews/NNN-*.md on the PR branch (frontmatter `verdict:`).
          # It counts only if the review commit is at least as new as the last non-review commit;
          # a Coder push after the review puts the story back in the Reviewer's lane.
          review="$(git ls-tree -r --name-only "origin/$branch" -- .team/reviews/ 2>/dev/null | grep "/${id}-" | head -1)"
          if [ -n "$review" ]; then
            verdict="$(git show "origin/$branch:$review" 2>/dev/null | sed -n 's/^verdict: *//p' | head -1)"
            review_ts="$(git log -1 --format=%ct "origin/$branch" -- "$review" 2>/dev/null || echo 0)"
            work_ts="$(git log -1 --format=%ct "origin/$branch" -- . ':(exclude).team/reviews' 2>/dev/null || echo 0)"
            if [ "${review_ts:-0}" -ge "${work_ts:-0}" ]; then
              case "$verdict" in
                approve*)  status=approved; next=po ;;  # PO merges the green, current, approved story PRs
                request*|changes*) status=changes-requested; next=coder ;;
                *) status=in-review; next=reviewer; where="$where (review has no verdict)" ;;
              esac
            else
              status=in-review; next=reviewer
            fi
          else
            status=in-review; next=reviewer
          fi
      case " $redprs " in
        *" $branch "*) status=ci-fails; next=reviewer; where="#$num (CI red)" ;;
      esac
      if [ "$status" != ci-fails ]; then
        case " $stale_prs " in
          *" $branch "*) status=ci-fails; next=reviewer; where="#$num (CI stalled)" ;;
        esac
      fi
      ;;
      esac
    fi
  fi

  # GitHub mirror override: bin/story pull marks a story closed/cancelled when
  # a human closes (or cancels) its issue on GitHub — git+PR state cannot see
  # that, so the board honors a terminal front-matter status when present.
  st_override="$(first_line "$story" status)"
  case "$st_override" in
    done|closed|cancelled) status="$st_override"; next="—"; where="gh" ;;
  esac
  # Main CI red from this story's merge: the Coder repairs it, winning over `done`
  # (a real red main is current fact); closed/cancelled is the human saying stop.
  if [ -n "$redmain" ] && [ "$redmain" = "$id" ]; then
    case "$status" in
      done|approved|in-review|changes-requested|in-progress|planned|needs-replan)
        status=needs-fix; next=coder; where="main CI red — fix $id" ;;
    esac
  fi
  ids+=("$id"); titles+=("$title"); sts+=("$status"); nxs+=("$next"); whs+=("$where"); urgs+=("$urgent"); aghs+=("$age_v"); paths+=("$story")

  # depends-on from story and plan frontmatter, unioned. One line, comma-separated;
  # tokens are kept only if they are exactly three digits; unknown IDs are filtered
  # later (dep-missing) once the full set of story IDs is known.
  dl=""
  for tok in $(printf '%s %s\n' "$(first_line "$story" depends-on)" "$([ -n "$plan" ] && first_line "$plan" depends-on)" | tr ',' ' '); do
    [ "${#tok}" -eq 3 ] && case "$tok" in *[!0-9]*) ;; *) dl="$dl $tok" ;; esac
  done
  deps+=("${dl# }"); miss+=("")
done <<< "$stories"

n="${#ids[@]}"
idset=" ${ids[*]} "
for i in $(seq 0 $((n - 1))); do
  keep=""; gone=""
  for tok in ${deps[$i]}; do
    case " $idset " in
      *" $tok "*) keep="$keep $tok" ;;
      *)               gone="$gone $tok" ;;
    esac
  done
  deps[$i]="${keep# }"; miss[$i]="${gone# }"
done

# ---- pass two: dependency gating. Errors are final and beat every other status —
# a wrong declaration (missing ID, or a cycle) is fixed by the PO and must not read
# as `blocked`, or the PO never sees it. Only `done` satisfies a dependency;
# `unknown`/`closed`/`blocked`/an error all fail closed.
cys=()
for i in $(seq 0 $((n - 1))); do
  if in_cycle "$i"; then cys[$i]=1; else cys[$i]=0; fi
done

# Error rows, decided once. `dep-missing` is named first when both apply.
err=()
for i in $(seq 0 $((n - 1))); do
  fst[$i]="${sts[$i]}"; fnx[$i]="${nxs[$i]}"; fwh[$i]="${whs[$i]}"
  err[$i]=0
  # Decided for every story, done/closed included: a cycle or a missing ID among
  # finished stories is still a broken declaration and must be reported (plan 018),
  # not masked by an intrinsic terminal status.
  if [ -n "${miss[$i]}" ]; then
    fst[$i]=dep-missing; fnx[$i]=po; fwh[$i]="missing: ${miss[$i]}"; err[$i]=1
  elif [ "${cys[$i]}" -eq 1 ]; then
    fst[$i]=dep-cycle; fnx[$i]=po; fwh[$i]="cycle with: ${deps[$i]}"; err[$i]=1
  fi
done

# `blocked` (non-error, non-done) computed to a fixed point, so an ignored story
# that depends on another blocked story is caught even when its dependency has a
# higher ID and so comes later in the loop.
blk=()
for i in $(seq 0 $((n - 1))); do blk[$i]=0; done
changed=1; rounds=0
while [ "$changed" -eq 1 ] && [ "$rounds" -le "$n" ]; do
  changed=0; rounds=$((rounds + 1))
  for i in $(seq 0 $((n - 1))); do
    [ "${err[$i]}" -eq 1 ] && continue
    [ "${blk[$i]}" -eq 1 ] && continue
    case "${sts[$i]}" in done|closed) continue ;; esac
    for tok in ${deps[$i]}; do
      ji="$(idxof "$tok")"
      # Only `done` satisfies a dependency — and `fst` already folds error rows
      # in, so a dep flagged dep-cycle/dep-missing (even when its own story is
      # intrinsically done) still counts as not done.
      if [ -n "$ji" ] && { [ "${blk[$ji]}" -eq 1 ] || [ "${fst[$ji]}" != done ]; }; then
        blk[$i]=1; changed=1; break
      fi
    done
  done
done

# Label settling for blocked rows. Run the where-building twice so nested labels
# read each other's final status (an ignored `blocked by 016 (…)` sees 016's final
# row, not its intrinsic one). Error rows keep their final status untouched.
for pass in 1 2; do
  for i in $(seq 0 $((n - 1))); do
    [ "${err[$i]}" -eq 1 ] && continue
    case "${sts[$i]}" in done|closed) continue ;; esac
    if [ "${blk[$i]}" -eq 1 ]; then
      depsw=""
      for tok in ${deps[$i]}; do
        ji="$(idxof "$tok")"; [ -n "$ji" ] || continue
        if [ "${blk[$ji]}" -eq 1 ] || [ "${fst[$ji]}" != done ]; then
          depsw="$depsw $tok(${fst[$ji]})"
        fi
      done
      fst[$i]=blocked; fnx[$i]=—; fwh[$i]="blocked by:${depsw}"
    fi
  done
done

for i in $(seq 0 $((n - 1))); do
  urgcol=""; [ "${urgs[$i]}" -eq 1 ] && urgcol="urgent"
  h="${aghs[$i]:-}"
  if [ -z "$h" ] && [ -n "${paths[$i]}" ]; then
    c="$(ctime "${paths[$i]}")"; [ "$c" -gt 0 ] 2>/dev/null && h="$(( (now - c) / 3600 ))"
  fi
  ttl="${titles[$i]}"
  if [ -n "$h" ] && [ "$h" -ge "$STALE_HOURS" ] 2>/dev/null; then
    case "${fst[$i]}" in done|closed|cancelled) ;; *) ttl="$ttl (stale ${h}h)" ;; esac
  fi
  if [ "$TSV" -eq 1 ]; then printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${ids[$i]}" "${fst[$i]}" "$ttl" "${fnx[$i]}" "${fwh[$i]}" "${urgs[$i]}"
  else printf '%-4s %-5s %-18s %-38s %-10s %s\n' "${ids[$i]}" "$urgcol" "${fst[$i]}" "${ttl:0:38}" "${fnx[$i]}" "${fwh[$i]}"; fi
done
