#!/usr/bin/env bash
# The board. Status is derived from git and GitHub — never written by hand.
#
#   ready              story on main, no plan                     → architect
#   needs-split        plan says the story is too big             → po
#   planned            plan on main, no branch yet                → coder
#   needs-replan       coder note newer than the plan             → architect
#   in-progress        remote branch exists, no PR                → coder
#   unknown            branch exists but GitHub could not be asked → nobody (look, don't work)
#   in-review          PR open, no review yet or new commits since → reviewer
#   changes-requested  review file on the branch says so (by ancestry, not
#                      date), OR the PR is CONFLICTING against main (wins
#                      over everything else, whatever the review says) → coder
#   ci-fails           PR branch's latest run failed, errored, timed out,
#                      was cancelled, or never ran -- unless the current
#                      review already says request-changes, in which case
#                      it stays changes-requested (the Coder needs no second
#                      trip through the Reviewer to hear "still red")  → reviewer
#   needs-fix          main CI is red, attributed to the story whose PR merged
#                      the FIRST red run in the current streak (not whatever
#                      commit the latest run happens to sit on)        → coder
#   main-red           main CI is red but the first red run's commit merged
#                      no story PR at all (bookkeeping, a direct push, a
#                      CI-only PR) -- a standalone row naming the commit and
#                      job, never a 3-digit story id                   → nobody
#   approved           review file on the branch says so               → po (merge)
# Rows in an actionable state whose last activity is older than STALE_HOURS
# (default 24) get a "(stale Nh)" marker on the title — the board's escape
# valve, so no story can quietly stall in a lane.
# The verdict is the `verdict:` line of .team/reviews/NNN-*.md on the PR branch — git, not
# GitHub's review decision (which GitHub refuses when one account authored the PR and reviews it).
#   done / closed      PR merged / closed                         → —
#                      (story 067) a merged PR is `done` before plan/note/branch
#                      timestamps are even asked, and a mirror-written
#                      `status: closed` from `bin/story pull` cannot move it
#                      back to `closed` -- only a human's `cancelled`, and a
#                      real `needs-fix` (red main), outrank `done`.
#   blocked            a declared dependency is not `done` yet    → nobody (wait)
#   held               `not-before:` date on the story is still in the future → nobody (wait)
#   dep-missing        `depends-on:` names a story that does not exist → po
#   dep-cycle          declared dependencies form a loop (incl. self) → po
#   date-invalid       `not-before:` does not parse as YYYY-MM-DD       → po
#
# `not-before: YYYY-MM-DD` (story frontmatter only, like `urge:`) holds a story
# out of every lane until that date. The date is compared to this host's own
# `date +%F` — local calendar day, evaluated once per run, no timezone field.
# A date already today or in the past has no effect. Held work still appears
# on the board (WHERE names the date) — invisible work is the failure mode
# this exists to prevent. A malformed date is `date-invalid`, not silently
# held forever or dropped.
#
# A story — or a plan, discovered while planning — may declare `depends-on: 001, 002`
# in its frontmatter: one line, comma-separated, plain IDs; nothing here parses YAML.
# Only `done` satisfies a dependency. Unknown, closed, blocked and error rows all count
# as not done, so a dependency GitHub cannot be asked about (AC8) blocks rather than
# slips through as workable — the same lesson this script wrote down below for PRs.
set -uo pipefail
TSV=0; [ "${1:-}" = "--tsv" ] && TSV=1   # machine-readable: id<TAB>status<TAB>title<TAB>next<TAB>where<TAB>urge, no header
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! git fetch -q origin 2>/dev/null; then
  echo "warning: git fetch failed — no network from here? the board may be stale" >&2
fi

DEFAULT="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
[ -n "$DEFAULT" ] || DEFAULT=main
MAIN="origin/$DEFAULT"

# How old a row may be in an actionable state before it gets a `(stale Nh)`
# marker. Age comes from the PR's last update (when the story has a PR) or the
# story/branch commit time otherwise; informational — it exists so wait-for
# hands an opener a stale story and the Reviewer's idle sweep can name it.
STALE_HOURS="${STALE_HOURS:-24}"
now="$(date +%s)"

# Every PR in the repo, in one query. It used to be one `gh pr list` per story,
# which is a GraphQL call per story per run: a thirty-story backlog polled by
# four roles every ninety seconds spends an API budget in an afternoon, and what
# happens when it runs out is worse than slowness — see below.
have_gh=0
gh_why=""
prs=""
if ! command -v gh >/dev/null 2>&1 || ! gh auth status >/dev/null 2>&1; then
  gh_why="no gh"
  echo "warning: gh missing, not authenticated, or no network — PR states unknown; branches show as unknown" >&2
elif prs="$(gh pr list --state all --limit 500 --json number,state,headRefName,updatedAt,mergeable \
            --jq '.[] | [.headRefName, .number, .state, ((now - (.updatedAt|fromdateiso8601)) / 3600 | floor),
                         (if .mergeable=="CONFLICTING" then 1 else "" end)] | @tsv' 2>/dev/null)"; then
  have_gh=1
else
  # The distinction that matters. A failed query and a repo with no PRs both
  # come back empty, and reading a failure as "no PR yet" hands every merged
  # story back to the Coder as fresh work. Rate-limit exhaustion did exactly
  # that: thirty-one `done` stories turned into thirty-one `in-progress` rows
  # in the Coder's lane, with no warning, because the error was swallowed.
  gh_why="gh failed"
  echo "warning: gh could not list PRs (rate limit? network?) — PR states unknown; branches show as unknown" >&2
fi

# CI visibility for the board. Two extra gh list calls, once per poll: the set of
# branches whose latest PR-event run went badly — failed, errored, timed out, or
# cancelled (red or stalled PR -> ci-fails), plus branches with an open PR that
# has no PR-event run at all (stalled -> ci-fails) — and a window of main's own
# runs (red main -> needs-fix on the story whose PR merged the FIRST red run in
# the current streak; a red run on no story's commit at all -> a standalone
# `main`/`main-red` row, story 051). Both are advisory facts about GitHub; when
# gh cannot be asked they simply leave the existing lanes alone, matching the
# prs block above.
redprs=""; redmain=""; redmain_where=""; main_red=0; stale_prs=""
if [ "$have_gh" -eq 1 ]; then
  raw_runs="$(gh run list --limit 500 --json headBranch,event,conclusion,createdAt \
            --jq '.[] | select(.event=="pull_request") | [.headBranch,.conclusion,.createdAt] | @tsv' \
            2>/dev/null)"
  # Newest run per branch first (createdAt sorts lexicographically; gh list is
  # already newest-first, this is belt and braces), then the ones that went bad.
  redprs="$(printf '%s\n' "$raw_runs" | sort -k3r | awk -F'\t' '!s[$1]++ { if ($2=="failure"||$2=="errored"||$2=="timed_out"||$2=="cancelled") print $1 }' | sort -u | tr '\n' ' ')"
  runs_branches="$(printf '%s\n' "$raw_runs" | cut -f1 | sort -u | tr '\n' ' ')"
  if [ -n "$prs" ] && [ -n "$runs_branches" ]; then
    # An open PR branch the runs list has never seen is stalled — the reviewer
    # sweep requeues or re-triggers it. Brand-new branches appear in the runs
    # list the moment a workflow starts (queued), so this does not false-fire.
    # Plain loop, not a case-inside-$( ) pipeline: bash 3.2 misparses that.
    for b in $(printf '%s\n' "$prs" | awk -F'\t' '$3=="OPEN" && $1!="" {print $1}'); do
      case " $runs_branches " in *" $b "*) ;; *) stale_prs="$stale_prs $b" ;; esac
    done
  fi
  # A window, not just the newest run: red main is attributed to the FIRST red
  # run in the current streak, not whatever commit the latest run happens to
  # sit on (story 051 -- a red source-budget run pinned on 048 by commit text
  # alone, then a DiskFullError red from #551/story 040 showed as needs-fix on
  # 050, because that's whose bookkeeping commit the latest run happened to
  # land on). 40 runs is not exhaustive, but this is advisory board state, not
  # an audit trail -- a streak longer than that has bigger problems.
  main_runs="$(gh run list --branch "${MAIN#origin/}" --limit 40 \
            --json conclusion,displayTitle,headSha,name \
            --jq '.[] | [.conclusion, .displayTitle, .headSha, .name] | @tsv' 2>/dev/null)"
  # One pass, newest-first (gh's own order): key on the newest run per headSha
  # (a commit can have several runs/workflows; only its most recent matters),
  # walk back through failures, stop at the first success. "cancelled",
  # "skipped" and empty (still running/queued) neither end nor extend the
  # streak -- applied uniformly to every row, including the newest: an
  # in-progress or cancelled newest run is not proof main is green, it is
  # simply not yet an answer either way, and an older unresolved `failure`
  # underneath it is still red (review, round 1 -- a special case here used
  # to print "not red" the instant the newest row wasn't literally
  # `"failure"`, silently hiding exactly the red streak this story exists to
  # surface). Whatever failure is left standing when the walk stops (a
  # success, or the window runs out) is the oldest -- the actual start of the
  # red run -- because each later failure overwrites the previous answer as
  # the walk moves further back in time. A genuinely green newest run falls
  # out of this the same way: `sha` never gets set before `success` exits the
  # walk, so the END block prints nothing and the caller below reads that as
  # not-red.
  main_red_line="$(printf '%s\n' "$main_runs" | awk -F'\t' '
    !seen[$3]++ {
      if ($1 == "failure") { sha=$3; title=$2; job=$4 }
      else if ($1 == "success") { exit }
    }
    END { if (sha != "") print "RED\t" sha "\t" title "\t" job }
  ')"
  if [ "${main_red_line%%$'\t'*}" = "RED" ]; then
    main_red=1
    IFS=$'\t' read -r _tag redsha redtitle redjob <<< "$main_red_line"
    # A squash-merge title ends "... (#N)"; GitHub can truncate displayTitle
    # for a long one, cutting that suffix off, so fall back to the commit's
    # own (untruncated) subject line when the title alone has none.
    prn="$(printf '%s' "$redtitle" | grep -oE '\(#[0-9]+\)' | tail -1 | tr -d '()#')"
    if [ -z "$prn" ]; then
      redsubject="$(git log -1 --format=%s "$redsha" 2>/dev/null)"
      prn="$(printf '%s' "$redsubject" | grep -oE '\(#[0-9]+\)' | tail -1 | tr -d '()#')"
    fi
    redbranch=""
    [ -n "$prn" ] && [ -n "$prs" ] && redbranch="$(printf '%s\n' "$prs" | awk -F'\t' -v n="$prn" '$2==n {print $1; exit}')"
    if [ -n "$redbranch" ]; then
      redmain="$(printf '%s' "$redbranch" | sed -n 's|^[^/]*/\([0-9][0-9][0-9]\)-.*|\1|p')"
    fi
    # Empty `redmain` here (no PR number in the title, no matching branch, or
    # a branch with no NNN- story id -- a bookkeeping commit, a direct push,
    # a CI-only PR) means nobody's story caused this: name the commit and job
    # instead of guessing (AC2), rather than falling back to the old
    # "first three-digit number in the text" heuristic that caused this story.
    redmain_where="${redsha:0:7} $redjob — $redtitle"
  fi
fi

stories="$(git ls-tree -r --name-only "$MAIN" -- .team/backlog/ 2>/dev/null | grep -E '/[0-9]{3}-.*\.md$' | sort)"
if [ -z "$stories" ]; then [ "$TSV" -eq 1 ] || echo "backlog is empty"; exit 0; fi

first_line() { git show "$MAIN:$1" 2>/dev/null | sed -n "s/^$2: *//p" | head -1; }
ctime()      { git log -1 --format=%ct "$MAIN" -- "$1" 2>/dev/null || echo 0; }
idxof()      { local i; for i in "${!ids[@]}"; do [ "${ids[$i]}" = "$1" ] && { echo "$i"; return; }; done; }
in_cycle()   { # $1 = start index; true if a declared cycle passes through it (incl. self)
  # Forward reachability from start: node is in a cycle iff a successor eventually
  # points back at start. A plain indexed-array BFS — safe on bash 3.2.
  local start=$1 i j ji head=0
  local seen=()
  local q=("$start")
  seen[$start]=1
  while [ "$head" -lt "${#q[@]}" ]; do
    i="${q[$head]}"; head=$((head + 1))
    for j in ${deps[$i]}; do
      ji="$(idxof "$j")"; [ -n "$ji" ] || continue
      if [ "$ji" -eq "$start" ]; then return 0; fi
      [ "${seen[$ji]:-0}" -eq 1 ] && continue
      seen[$ji]=1; q+=("$ji")
    done
  done
  return 1
}

[ "$TSV" -eq 1 ] || printf '%-4s %-5s %-18s %-38s %-10s %s\n' ID URGE STATUS TITLE NEXT WHERE

# Story 051, AC2: main is red but the first red run's commit merged no story
# PR at all (a bookkeeping commit, a direct push, a CI-only PR) -- a single
# extra row naming the commit and job, never a 3-digit id (`bin/story` looks
# rows up by story id; this must not collide with one), never a role in NEXT
# (`wait-for` matches `next` exactly; nobody should pick this up as work).
if [ "$main_red" -eq 1 ] && [ -z "$redmain" ]; then
  if [ "$TSV" -eq 1 ]; then
    printf 'main\tmain-red\t%s\t—\t%s\t0\n' "$redmain_where" "$redmain_where"
  else
    printf '%-4s %-5s %-18s %-38s %-10s %s\n' main "" main-red "${redmain_where:0:38}" — "$redmain_where"
  fi
fi

# ---- pass one: the intrinsic status of every story, exactly as before. Dependency
# gating cannot happen inline: a row's verdict depends on the *other* rows, so every
# intrinsic status must be known before any final row is decided. Collect it all first.
ids=(); titles=(); sts=(); nxs=(); whs=(); deps=(); miss=(); urgs=(); aghs=(); paths=(); nbs=(); nbvalids=()
while IFS= read -r story; do
  base="$(basename "$story" .md)"; id="${base%%-*}"
  title="$(first_line "$story" title)"
  # `urge:` is a PO input read from the story only — not the plan, which is the
  # Architect's reach. Anything but true/yes/1 (a bare marker, a typo, a word)
  # is not urgent; the row is still emitted either way (AC7, AC8).
  case "$(first_line "$story" urge | tr '[:upper:]' '[:lower:]')" in
    true|yes|1) urgent=1 ;;
    *) urgent=0 ;;
  esac
  # `not-before:` is a PO input read from the story only, like `urge:` above --
  # not the plan, which is the Architect's reach. Empty means no gate. A value
  # is valid iff it is exactly YYYY-MM-DD with month 01-12 and day 01-31 (a
  # day beyond the real calendar, e.g. 2026-02-30, is accepted and simply
  # holds until the next valid date lexicographically greater than it --
  # 10# strips bash 3.2's octal reading of a leading zero). Anything else
  # ("november", "2026-11-1", "2026-13-40", a bare "not-before:") is invalid.
  nb="$(first_line "$story" not-before)"
  nb_valid=1
  if [ -n "$nb" ]; then
    if [[ "$nb" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
      nb_mm="${nb:5:2}"; nb_dd="${nb:8:2}"
      if [ "$((10#$nb_mm))" -ge 1 ] && [ "$((10#$nb_mm))" -le 12 ] \
         && [ "$((10#$nb_dd))" -ge 1 ] && [ "$((10#$nb_dd))" -le 31 ]; then
        nb_valid=1
      else
        nb_valid=0
      fi
    else
      nb_valid=0
    fi
  fi
  plan="$(git ls-tree -r --name-only "$MAIN" -- .team/plans/ | grep "/${id}-" | head -1)"
  note="$(git ls-tree -r --name-only "$MAIN" -- .team/notes/ | grep "/${id}-" | head -1)"
  branch="$(git branch -r --list "origin/feat/${id}-*" | head -1 | sed 's|^ *origin/||')"
  status=""; next=""; where=""; age_v=""

  # Story 067: a merged PR is `done` before anything else is asked -- plan/note/
  # branch timestamps, and a mirror-written `status: closed`, must not be able to
  # move a finished story backwards. Looked up by branch-prefix `^feat/NNN-`
  # (same pattern the deleted-branch fallback below already used), so it works
  # whether or not a local/remote branch still exists. Two PRs can match (a
  # `feat/NNN-fix-*` opened after a needs-fix) -- the newest by PR number is the
  # one whose merge state counts, so sort descending before taking the first.
  # have_gh=0 leaves early_status empty and the chain below runs exactly as
  # before (status=unknown), never defaulting to done.
  early_status=""; early_num=""
  if [ "$have_gh" -eq 1 ]; then
    early_match="$(printf '%s\n' "$prs" | awk -F'\t' -v id="$id" '$1 ~ "^feat/" id "-" {print $2"\t"$3}' \
                   | sort -t $'\t' -k1,1nr | head -1)"
    if [ -n "$early_match" ]; then
      IFS=$'\t' read -r early_num early_state <<< "$early_match"
      case "$early_state" in
        MERGED) early_status=done ;;
        CLOSED) early_status=closed ;;
      esac
    fi
  fi

  if [ -n "$early_status" ]; then
    status="$early_status"; next="—"; where="#$early_num"
  elif [ -z "$plan" ]; then
    status=ready; next=architect
  elif [ "$(first_line "$plan" verdict)" = "needs-split" ]; then
    status=needs-split; next=po
  elif [ -n "$note" ] && [ "$(ctime "$note")" -gt "$(ctime "$plan")" ]; then
    status=needs-replan; next=architect; where="$note"
  elif [ -z "$branch" ]; then
    # No remote branch is "no work yet" only until proven otherwise: a merged
    # (or closed) PR gets its branch deleted too — by the merge flow or by
    # hand — and without this fallback a finished story re-enters the board as
    # `planned` forever the moment its branch is gone, so the Coder redoes it.
    fallback_pr=""
    if [ "$have_gh" -eq 1 ]; then
      fallback_pr="$(printf '%s\n' "$prs" | awk -F'\t' -v id="$id" '$1 ~ "^feat/" id "-" {print $1"\t"$2"\t"$3"\t"$4; exit}')"
    fi
    if [ -z "$fallback_pr" ]; then
      status=planned; next=coder; where="$plan"
    else
      IFS=$'\t' read -r _fb_branch fb_num fb_state fb_age <<< "$fallback_pr"
      age_v="${fb_age:-}"
      where="#$fb_num"
      case "$fb_state" in
        MERGED) status=done; next="—" ;;
        CLOSED) status=closed; next="—" ;;
        # Branch gone but the PR is still open is rare (manual branch delete);
        # there is no branch left to read a review verdict from, so hand it
        # back to the reviewer rather than guessing.
        *) status=in-review; next=reviewer; where="$where (branch deleted)" ;;
      esac
    fi
  elif [ "$have_gh" -eq 0 ]; then
    # Not `in-progress`: we do not know, and `next` must not name a role, or an
    # unattended Coder picks the row up. `wait-for` matches the role exactly.
    status=unknown; next="—"; where="$branch ($gh_why)"
    bct="$(git log -1 --format=%ct "origin/$branch" 2>/dev/null || echo 0)"; [ "$bct" -gt 0 ] 2>/dev/null && age_v=$(( (now - bct) / 3600 ))
  else
    pr="$(printf '%s\n' "$prs" | awk -F'\t' -v b="$branch" '$1==b {print $2"\t"$3"\t"$4"\t"$5; exit}')"
    if [ -z "$pr" ]; then
      status=in-progress; next=coder; where="$branch"
      bct="$(git log -1 --format=%ct "origin/$branch" 2>/dev/null || echo 0)"; [ "$bct" -gt 0 ] 2>/dev/null && age_v=$(( (now - bct) / 3600 ))
    else
      IFS=$'\t' read -r num state prh conflict <<< "$pr"
      age_v="$prh"
      where="#$num"
      case "$state" in
        MERGED) status=done; next="—" ;;
        CLOSED) status=closed; next="—" ;;
        *)
          # The verdict lives in .team/reviews/NNN-*.md on the PR branch (frontmatter `verdict:`).
          # It counts only if the review commit is at least as new as the last non-review commit;
          # a Coder push after the review puts the story back in the Reviewer's lane. "New" is
          # decided by commit ancestry, not committer date (story 060): a rebase rewrites every
          # commit's committer date to the moment of the rebase, so a review commit and a Coder's
          # fix that followed it can land in the same epoch second -- a plain date comparison then
          # ties in the review's favour and the board keeps saying the review is the latest word,
          # even though the fix is objectively a descendant of it. Timestamps (review_ts/work_ts)
          # are kept only as the fallback for unrelated histories, where ancestry can't decide.
          review="$(git ls-tree -r --name-only "origin/$branch" -- .team/reviews/ 2>/dev/null | grep "/${id}-" | head -1)"
          if [ -n "$review" ]; then
            verdict="$(git show "origin/$branch:$review" 2>/dev/null | sed -n 's/^verdict: *//p' | head -1)"
            review_sha="$(git log -1 --format=%H "origin/$branch" -- "$review" 2>/dev/null)"
            work_sha="$(git log -1 --format=%H "origin/$branch" -- . ':(exclude).team/reviews' 2>/dev/null)"
            review_ts="$(git log -1 --format=%ct "origin/$branch" -- "$review" 2>/dev/null || echo 0)"
            work_ts="$(git log -1 --format=%ct "origin/$branch" -- . ':(exclude).team/reviews' 2>/dev/null || echo 0)"
            review_current=1
            if [ -n "$review_sha" ] && [ -n "$work_sha" ] && [ "$review_sha" != "$work_sha" ]; then
              if git merge-base --is-ancestor "$review_sha" "$work_sha" 2>/dev/null; then
                review_current=0
              elif git merge-base --is-ancestor "$work_sha" "$review_sha" 2>/dev/null; then
                review_current=1
              elif [ "${review_ts:-0}" -ge "${work_ts:-0}" ]; then
                review_current=1
              else
                review_current=0
              fi
            fi
            if [ "$review_current" -eq 1 ]; then
              case "$verdict" in
                approve*)  status=approved; next=po ;;  # PO merges the green, current, approved story PRs
                request*|changes*) status=changes-requested; next=coder ;;
                *) status=in-review; next=reviewer; where="$where (review has no verdict)" ;;
              esac
            else
              status=in-review; next=reviewer
            fi
          else
            status=in-review; next=reviewer
          fi
      # Story 050: three rules, in this order.
      #  1. CONFLICTING wins over everything -- a conflicting PR cannot be
      #     merged and needs no review to say "rebase", whatever the review
      #     file or CI says.
      #  2. Otherwise, red or stalled CI with a *current* request-changes
      #     review (the case above already produced changes-requested, which
      #     only happens when that review is newer than the last work commit)
      #     stays with the Coder -- they already have a must-fix list; naming
      #     the CI reason in WHERE is enough, no second trip through the
      #     Reviewer to hear "still red".
      #  3. Red or stalled otherwise (approved, in-review, no review, or a
      #     stale review) is exactly today's ci-fails/reviewer.
      if [ "$conflict" = "1" ]; then
        status=changes-requested; next=coder; where="#$num (conflict)"
      else
        is_red=0; is_stalled=0
        case " $redprs " in *" $branch "*) is_red=1 ;; esac
        if [ "$is_red" -eq 0 ]; then
          case " $stale_prs " in *" $branch "*) is_stalled=1 ;; esac
        fi
        if [ "$is_red" -eq 1 ] || [ "$is_stalled" -eq 1 ]; then
          reason="CI stalled"; [ "$is_red" -eq 1 ] && reason="CI red"
          if [ "$status" = changes-requested ]; then
            where="#$num ($reason)"
          else
            status=ci-fails; next=reviewer; where="#$num ($reason)"
          fi
        fi
      fi
      ;;
      esac
    fi
  fi

  # GitHub mirror override: bin/story pull marks a story closed/cancelled when
  # a human closes (or cancels) its issue on GitHub — git+PR state cannot see
  # that, so the board honors a terminal front-matter status when present.
  # Story 067: `done` (this story's PR merged) is current fact a mirror sync
  # cannot un-happen, so a mirror-written `status: closed` no longer beats it —
  # only `cancelled` (never written by the sync; a human's word) still does.
  st_override="$(first_line "$story" status)"
  case "$st_override" in
    cancelled) status="$st_override"; next="—"; where="gh" ;;
    done) status="$st_override"; next="—"; where="gh" ;;
    closed) [ "$status" = done ] || { status="$st_override"; next="—"; where="gh"; } ;;
  esac
  # Main CI red from this story's merge: the Coder repairs it, winning over `done`
  # (a real red main is current fact); closed/cancelled is the human saying stop.
  if [ -n "$redmain" ] && [ "$redmain" = "$id" ]; then
    case "$status" in
      done|approved|in-review|changes-requested|in-progress|planned|needs-replan)
        status=needs-fix; next=coder; where="main CI red — fix $id" ;;
    esac
  fi
  ids+=("$id"); titles+=("$title"); sts+=("$status"); nxs+=("$next"); whs+=("$where"); urgs+=("$urgent"); aghs+=("$age_v"); paths+=("$story"); nbs+=("$nb"); nbvalids+=("$nb_valid")

  # depends-on from story and plan frontmatter, unioned. One line, comma-separated;
  # tokens are kept only if they are exactly three digits; unknown IDs are filtered
  # later (dep-missing) once the full set of story IDs is known. A plan restating
  # a dependency its story already declares is not an error (a plan planning
  # around a dependency is reasonable), so the same ID from both sources is kept
  # once, in the order it was first seen, rather than listed twice on the board.
  dl=""
  for tok in $(printf '%s %s\n' "$(first_line "$story" depends-on)" "$([ -n "$plan" ] && first_line "$plan" depends-on)" | tr ',' ' '); do
    [ "${#tok}" -eq 3 ] && case "$tok" in *[!0-9]*) ;; *) case " $dl " in *" $tok "*) ;; *) dl="$dl $tok" ;; esac ;; esac
  done
  deps+=("${dl# }"); miss+=("")
done <<< "$stories"

n="${#ids[@]}"
idset=" ${ids[*]} "
for i in $(seq 0 $((n - 1))); do
  keep=""; gone=""
  for tok in ${deps[$i]}; do
    case " $idset " in
      *" $tok "*) keep="$keep $tok" ;;
      *)               gone="$gone $tok" ;;
    esac
  done
  deps[$i]="${keep# }"; miss[$i]="${gone# }"
done

# ---- pass two: dependency gating. Errors are final and beat every other status —
# a wrong declaration (missing ID, or a cycle) is fixed by the PO and must not read
# as `blocked`, or the PO never sees it. Only `done` satisfies a dependency;
# `unknown`/`closed`/`blocked`/an error all fail closed.
cys=()
for i in $(seq 0 $((n - 1))); do
  if in_cycle "$i"; then cys[$i]=1; else cys[$i]=0; fi
done

# Error rows, decided once. `dep-missing` is named first when both apply.
err=()
for i in $(seq 0 $((n - 1))); do
  fst[$i]="${sts[$i]}"; fnx[$i]="${nxs[$i]}"; fwh[$i]="${whs[$i]}"
  err[$i]=0
  # Decided for every story, done/closed included: a cycle or a missing ID among
  # finished stories is still a broken declaration and must be reported (plan 018),
  # not masked by an intrinsic terminal status.
  if [ -n "${miss[$i]}" ]; then
    fst[$i]=dep-missing; fnx[$i]=po; fwh[$i]="missing: ${miss[$i]}"; err[$i]=1
  elif [ "${cys[$i]}" -eq 1 ]; then
    fst[$i]=dep-cycle; fnx[$i]=po; fwh[$i]="cycle with: ${deps[$i]}"; err[$i]=1
  elif [ -n "${nbs[$i]}" ] && [ "${nbvalids[$i]}" -eq 0 ]; then
    fst[$i]=date-invalid; fnx[$i]=po; fwh[$i]="not-before: ${nbs[$i]}"; err[$i]=1
  fi
done

# `blocked` (non-error, non-done) computed to a fixed point, so an ignored story
# that depends on another blocked story is caught even when its dependency has a
# higher ID and so comes later in the loop.
blk=()
for i in $(seq 0 $((n - 1))); do blk[$i]=0; done
changed=1; rounds=0
while [ "$changed" -eq 1 ] && [ "$rounds" -le "$n" ]; do
  changed=0; rounds=$((rounds + 1))
  for i in $(seq 0 $((n - 1))); do
    [ "${err[$i]}" -eq 1 ] && continue
    [ "${blk[$i]}" -eq 1 ] && continue
    case "${sts[$i]}" in done|closed) continue ;; esac
    for tok in ${deps[$i]}; do
      ji="$(idxof "$tok")"
      # Only `done` satisfies a dependency — and `fst` already folds error rows
      # in, so a dep flagged dep-cycle/dep-missing (even when its own story is
      # intrinsically done) still counts as not done.
      if [ -n "$ji" ] && { [ "${blk[$ji]}" -eq 1 ] || [ "${fst[$ji]}" != done ]; }; then
        blk[$i]=1; changed=1; break
      fi
    done
  done
done

# `held`: a not-before date still in the future, checked after blocked (a
# declared dependency is something a person might act on; the date resolves
# itself with no one intervening) and before the blocked-label settling below,
# so a dependent's "blocked by: 028(held)" reads the final status. Terminal
# rows never held -- `st_override` above already folded done/closed/cancelled
# into `sts[$i]` before this story's arrays were pushed.
today="$(date +%F)"
for i in $(seq 0 $((n - 1))); do
  [ "${err[$i]}" -eq 1 ] && continue
  [ "${blk[$i]}" -eq 1 ] && continue
  case "${sts[$i]}" in done|closed|cancelled) continue ;; esac
  if [ -n "${nbs[$i]}" ] && [ "${nbvalids[$i]}" -eq 1 ] && [[ "${nbs[$i]}" > "$today" ]]; then
    fst[$i]=held; fnx[$i]=—; fwh[$i]="until ${nbs[$i]} (${sts[$i]})"
  fi
done

# Label settling for blocked rows. Run the where-building twice so nested labels
# read each other's final status (an ignored `blocked by 016 (…)` sees 016's final
# row, not its intrinsic one). Error rows keep their final status untouched.
for pass in 1 2; do
  for i in $(seq 0 $((n - 1))); do
    [ "${err[$i]}" -eq 1 ] && continue
    case "${sts[$i]}" in done|closed) continue ;; esac
    if [ "${blk[$i]}" -eq 1 ]; then
      depsw=""
      for tok in ${deps[$i]}; do
        ji="$(idxof "$tok")"; [ -n "$ji" ] || continue
        if [ "${blk[$ji]}" -eq 1 ] || [ "${fst[$ji]}" != done ]; then
          depsw="$depsw $tok(${fst[$ji]})"
        fi
      done
      fst[$i]=blocked; fnx[$i]=—; fwh[$i]="blocked by:${depsw}"
    fi
  done
done

for i in $(seq 0 $((n - 1))); do
  urgcol=""; [ "${urgs[$i]}" -eq 1 ] && urgcol="urgent"
  h="${aghs[$i]:-}"
  if [ -z "$h" ] && [ -n "${paths[$i]}" ]; then
    c="$(ctime "${paths[$i]}")"; [ "$c" -gt 0 ] 2>/dev/null && h="$(( (now - c) / 3600 ))"
  fi
  ttl="${titles[$i]}"
  if [ -n "$h" ] && [ "$h" -ge "$STALE_HOURS" ] 2>/dev/null; then
    case "${fst[$i]}" in done|closed|cancelled) ;; *) ttl="$ttl (stale ${h}h)" ;; esac
  fi
  if [ "$TSV" -eq 1 ]; then printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${ids[$i]}" "${fst[$i]}" "$ttl" "${fnx[$i]}" "${fwh[$i]}" "${urgs[$i]}"
  else printf '%-4s %-5s %-18s %-38s %-10s %s\n' "${ids[$i]}" "$urgcol" "${fst[$i]}" "${ttl:0:38}" "${fnx[$i]}" "${fwh[$i]}"; fi
done
