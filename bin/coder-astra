#!/usr/bin/env bash
# Coder fallback — opencode gpt-6-astra-fast, used by the watchdog when a claude spend
# limit blocks the primary coder. Reads the same role file via a dedicated config.
[ $# -gt 0 ] || set -- 'Begin. Follow the "On start" section of your role.'
exec "$(dirname "$0")/_start" coder coder.md \
  env OPENCODE_CONFIG="$HOME/.config/opencode/agent-team-astra-fast.json" \
  opencode run --interactive \
  'You are the Coder. Read AGENTS.md, then your role file at ROLEFILE, and follow its "On start" section.' "$@"