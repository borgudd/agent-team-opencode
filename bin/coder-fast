#!/usr/bin/env bash
# Coder fallback — sonnet, same model as the primary. In the past this ran
# haiku; a haiku session cannot use auto mode, so a limit-downgrade silently
# stalled the agent. A limit now only respawns the session on the same model.
[ $# -gt 0 ] || set -- 'Begin. Follow the "On start" section of your role.'
exec "$(dirname "$0")/_start" coder coder.md \
  env PATH="$HOME/.local/bin:$PATH" \
  claude --model sonnet --append-system-prompt-file ROLEFILE "$@"
