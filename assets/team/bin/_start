#!/usr/bin/env bash
# shared preamble for the role launchers: sync, sanity-check the clone, run
# usage: _start <role> <cmd...>
set -uo pipefail
role="$1"; shift
cd "$(git rev-parse --show-toplevel)" || exit 1

here="$(basename "$PWD")"
case "$here" in
  "$role"|"$role"-[0-9]*) ;;
  *) echo "warning: starting the $role in clone '$here' — each role should have its own clone" >&2 ;;
esac

git pull -q --rebase --autostash 2>/dev/null || echo "warning: git pull failed — check the remote before working" >&2
exec "$@"
